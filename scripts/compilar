#!/bin/sh
# Compila flujo para cada plataforma en bin/, de forma reproducible (Q163, Q165, Q166). Lo corre quien cambia el código
# Go, y los ejecutables van en el mismo commit; CI solo corre --verificar.
#
# Uso: scripts/compilar              escribe bin/flujo-<os>-<arch> para Linux y macOS y bin/flujo.exe para Windows
#      scripts/compilar --verificar  compila en una carpeta temporal y sale con 1 si algún ejecutable de bin/ no es
#                                    el que sale de la fuente, o si bin/ tiene un ejecutable que ya no se compila
#
# flujo.exe es el de windows/amd64 y es el ejecutable mismo, no un lanzador (Q165). Windows 11 en ARM64 lo corre emulado,
# así que no hay uno para windows/arm64; Windows 10 en ARM64, sin soporte, no lo corre.
#
# El mismo commit da los mismos bytes en Linux, macOS y Windows: sin cgo, -trimpath, -buildvcs=false, sin build ID,
# GOAMD64 y GOARM64 fijos y la versión de Go de go.mod, que GOTOOLCHAIN descarga si la instalada es otra.
set -eu

raiz=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$raiz"

case ${1-} in
  '') destino=bin ;;
  --verificar) destino=$(mktemp -d) && trap 'rm -rf "$destino"' EXIT ;;
  *) echo "uso: scripts/compilar [--verificar]" >&2 && exit 2 ;;
esac

version=$(sed -n 's/^go \([0-9.]*\)$/\1/p' go.mod)
[ -n "$version" ] || { echo "compilar: go.mod no dice la versión de Go" >&2; exit 1; }

distintos=''
esperados=flujo
for plataforma in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 windows/amd64; do
  os=${plataforma%/*}
  arch=${plataforma#*/}
  nombre=flujo-$os-$arch
  [ "$os" = windows ] && nombre=flujo.exe
  esperados="$esperados $nombre"
  CGO_ENABLED=0 GOOS=$os GOARCH=$arch GOAMD64=v1 GOARM64=v8.0 GOFLAGS='' GOTOOLCHAIN=go$version \
    go build -trimpath -buildvcs=false -ldflags='-s -w -buildid=' -o "$destino/$nombre" ./cmd/flujo
  if [ "$destino" != bin ] && ! cmp -s "$destino/$nombre" "bin/$nombre"; then
    distintos="$distintos $nombre"
  fi
done

sobran=''
for archivo in bin/*; do
  case " $esperados " in
    *" ${archivo#bin/} "*) ;;
    *) sobran="$sobran ${archivo#bin/}" ;;
  esac
done

if [ -n "$distintos" ]; then
  echo "compilar: estos ejecutables de bin/ no son los de la fuente:$distintos. Corre scripts/compilar y súmalos al commit." >&2
  exit 1
fi
if [ -n "$sobran" ]; then
  echo "compilar: bin/ tiene archivos que no se compilan:$sobran. Bórralos." >&2
  exit 1
fi
