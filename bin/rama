#!/bin/sh
# Lanzador de rama para Linux, macOS y Git Bash en Windows (Q161): corre el ejecutable de esta plataforma que está en
# esta carpeta, rama-<os>-<arch>, con los argumentos tal cual. Sin ejecutable para la plataforma, sale con 3.
dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd) || exit 3
sistema=$(uname -s)
maquina=$(uname -m)
case $sistema in
  Linux) os=linux ext='' ;;
  Darwin) os=darwin ext='' ;;
  MINGW* | MSYS*) os=windows ext=.exe ;;
  *) os='' ext='' ;;
esac
case $maquina in
  x86_64 | amd64) arch=amd64 ;;
  aarch64 | arm64) arch=arm64 ;;
  *) arch='' ;;
esac
ejecutable=$dir/rama-$os-$arch$ext
if [ -z "$os" ] || [ -z "$arch" ] || [ ! -f "$ejecutable" ]; then
  echo "rama: no hay ejecutable para esta plataforma ($sistema $maquina): falta $ejecutable." \
    "Hay para linux, darwin y windows, en amd64 y arm64." >&2
  exit 3
fi
exec "$ejecutable" "$@"
